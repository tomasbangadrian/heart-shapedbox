# OpenAI API Key
# Få din API-nøkkel fra: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Spotify API Credentials
# Få disse fra: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=https://your-app.vercel.app/api/spotify/callback

# Base URL (optional, defaults to production URL)
# For lokal utvikling: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Supabase Credentials
# Få disse fra: https://supabase.com (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
